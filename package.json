{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:content": "concurrently -n next,content \"next-remote-watch content\" \"chokidar 'content/**' -c 'npm run create-indexes && npm run copy-static-content'\"",
    "build": "npm run create-indexes && npm run copy-static-content && npm run create-rss-feed && npm run build:next",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint .",
    "tsc": "tsc",
    "create-indexes": "tsx ./content-processing/create-indexes.ts",
    "create-rss-feed": "tsx ./content-processing/create-rss-feed.ts",
    "copy-static-content": "rsync -avh --delete --exclude='**/*.mdx' content/articles/ public/static-content/",
    "fmt": "prettier --write --ignore-path .gitignore .",
    "fmt.check": "prettier --check --ignore-path .gitignore ."
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mdx-js/react": "^3.1.1",
    "fp-ts": "^2.16.11",
    "gray-matter": "^4.0.3",
    "next": "15.5.4",
    "next-mdx-remote": "^5.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "reading-time": "^1.5.0",
    "rehype-highlight": "^7.0.2",
    "rehype-img-size": "^1.0.1",
    "remark": "^15.0.1",
    "rimraf": "^6.0.1",
    "strip-markdown": "^6.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@mdx-js/loader": "^3.1.1",
    "@next/mdx": "^15.5.4",
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "eslint": "9.37.0",
    "eslint-config-next": "15.5.4",
    "glob": "^11.0.3",
    "next-remote-watch": "^2.0.0",
    "prettier": "^3.6.2",
    "remark-frontmatter": "^5.0.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
